# Copy to ".env" and fill in. Never commit ".env".

# --- MongoDB (required) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=my_database
# Embeddings are stored in this collection (same database unless EMBEDDINGS_DATABASE is set)
# EMBEDDINGS_COLLECTION=rag_embeddings
# EMBEDDINGS_DATABASE=

# --- LLM: any OpenAI-compatible API ---
# Default = Groq + gpt-oss-20b:
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# OpenAI instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Protect POST /api/ingest/ (required when DJANGO_DEBUG=False) ---
INGEST_TOKEN=change-me

# --- Embeddings (optional) ---
# EMBEDDING_PROVIDER=local            # local | openai
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_API_KEY=                  # only for provider=openai

# --- Search tuning (optional) ---
# TOP_K=5
# MIN_SCORE=0.15
# HYBRID_SEARCH=true
# MAX_HOPS=1
# MAX_RELATED=6
# INCLUDE_REVERSE=true
# CACHE_TTL_SECONDS=600

# --- Ingestion tuning (optional) ---
# BATCH_SIZE=500
# CHUNK_SIZE=700
# EXCLUDE_COLLECTIONS=logs,sessions
# EXCLUDE_FIELDS=ssn,phone

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
